{
  "name": "party-paper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js ads.test.js",
    "serve": "npm run build:static && node scripts/preview.mjs",
    "posttest": "node prepare-seo.js",
    "test:e2e": "playwright test",
    "build:static": "node scripts/build-static.mjs",
    "check:public": "node scripts/check-public.mjs",
    "build:live": "npm run build:static && node scripts/build-live.mjs",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:contracts": "npm run build:live && node --test tests/live/contracts.test.mjs",
    "test:rooms": "npm run build:live && node --test tests/live/rooms.test.mjs tests/live/transport.test.mjs",
    "test:live": "npm run build:live && node --test tests/live/*.test.mjs",
    "serve:live": "npm run build:live && node scripts/room-server.mjs"
  },
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "typescript": "5.8.3",
    "@types/node": "24.0.0"
  },
  "dependencies": {
    "ws": "8.21.3"
  }
}
